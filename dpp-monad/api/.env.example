# ============================================================
# dpp-monad/api — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real private keys.

# --- Monad Testnet RPC ---
RPC_URL=https://testnet-rpc.monad.xyz

# --- Deployed contract (do NOT change) ---
CONTRACT_ADDRESS=0xBCD966873f48563643Bde79760eEC98a567fd7e6

# --- Wallet private key (fund with testnet MON) ---
# Replace with your actual key. Keep this secret.
PRIVATE_KEY=your_private_key_here

# --- Envio HyperIndex (optional) ---
# Default: http://localhost:8080 (local envio dev)
# Set to your deployed Envio cloud endpoint when running in production.
# When unset or unreachable, the API falls back to getLogs RPC scan.
# ENVIO_GRAPHQL_URL=http://localhost:8080

# --- SQLite path override (optional) ---
# Defaults to: ../../Monad_hackathon/sqlite/donation_box.db
# SQLITE_FILE=../../Monad_hackathon/sqlite/donation_box.db
